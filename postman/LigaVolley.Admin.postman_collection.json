{
  "info": {
    "_postman_id": "03863c81-e0d8-4749-aaf0-6b9e90450001",
    "name": "LigaVolley - Admin API",
    "description": "Colección ejecutable para probar los vertical slices administrativos. Los requests de creación guardan automáticamente los IDs en el environment activo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [{
    "listen": "prerequest",
    "script": { "type": "text/javascript", "exec": [
      "if (!pm.collectionVariables.get('runSuffix')) {",
      "  pm.collectionVariables.set('runSuffix', Date.now().toString());",
      "}"
    ] }
  }],
  "variable": [{ "key": "runSuffix", "value": "" }],
  "item": [
    {
      "name": "01 - Catálogos y competición",
      "description": "Ejecutar en orden con Collection Runner. Construye datos independientes para una corrida.",
      "item": [
        {
          "name": "Crear temporada",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"year\": 2090,\n  \"name\": \"Postman {{runSuffix}}\",\n  \"startDate\": \"2090-01-01\",\n  \"endDate\": \"2090-12-31\"\n}" },
            "url": "{{baseUrl}}/api/admin/seasons"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "if (pm.response.code === 201) pm.environment.set('seasonId', pm.response.json().seasonId);"
          ] } }]
        },
        {
          "name": "Crear divisional",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman {{runSuffix}}\",\n  \"levelOrder\": 90,\n  \"gender\": \"Female\"\n}" },
            "url": "{{baseUrl}}/api/admin/divisions"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "if (pm.response.code === 201) pm.environment.set('divisionId', pm.response.json().divisionId);"
          ] } }]
        },
        {
          "name": "Validar formato",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"minTeams\": 2,\n  \"maxTeams\": 2,\n  \"definition\": {\n    \"phases\": [{ \"code\": \"REGULAR\", \"name\": \"Regular\", \"phaseType\": \"RoundRobin\", \"phaseRole\": \"Regular\", \"sequence\": 1, \"rounds\": 1, \"fixtureMode\": \"BalancedRandom\", \"groups\": [], \"series\": [] }],\n    \"qualificationRules\": [], \"scoringRules\": [], \"tiebreakRules\": [], \"movementRules\": []\n  }\n}" },
            "url": "{{baseUrl}}/api/admin/competition-formats/validate"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Formato válido', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().isValid).to.be.true; });"] } }]
        },
        {
          "name": "Crear formato",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"code\": \"PM_{{runSuffix}}\",\n  \"name\": \"Postman {{runSuffix}}\",\n  \"description\": \"Formato de prueba\",\n  \"minTeams\": 2,\n  \"maxTeams\": 2,\n  \"definition\": {\n    \"phases\": [{ \"code\": \"REGULAR\", \"name\": \"Regular\", \"phaseType\": \"RoundRobin\", \"phaseRole\": \"Regular\", \"sequence\": 1, \"rounds\": 1, \"fixtureMode\": \"BalancedRandom\", \"groups\": [], \"series\": [] }],\n    \"qualificationRules\": [], \"scoringRules\": [], \"tiebreakRules\": [], \"movementRules\": []\n  }\n}" },
            "url": "{{baseUrl}}/api/admin/competition-formats"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "if (pm.response.code === 201) pm.environment.set('formatId', pm.response.json().competitionFormatId);"
          ] } }]
        },
        {
          "name": "Crear competición",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman {{runSuffix}}\",\n  \"seasonId\": {{seasonId}},\n  \"divisionId\": {{divisionId}},\n  \"periodType\": \"Annual\",\n  \"startDate\": null,\n  \"endDate\": null,\n  \"structureSource\": { \"type\": \"Format\", \"competitionFormatId\": {{formatId}}, \"sourceCompetitionId\": null }\n}" },
            "url": "{{baseUrl}}/api/admin/competitions"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "if (pm.response.code === 201) pm.environment.set('competitionId', pm.response.json().competitionId);"
          ] } }]
        },
        {
          "name": "Consultar estructura",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/competitions/{{competitionId}}/structure" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Estructura instanciada', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().phases).to.have.lengthOf(1); });", "if (pm.response.code === 200) pm.environment.set('phaseId', pm.response.json().phases[0].phaseId);"] } }]
        }
      ]
    },
    {
      "name": "02 - Club, equipo e inscripción",
      "item": [
        {
          "name": "Crear club",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"name\": \"Club Postman {{runSuffix}}\", \"shortName\": \"PM\" }" }, "url": "{{baseUrl}}/api/admin/clubs" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('201 Created', () => pm.response.to.have.status(201));", "if (pm.response.code === 201) pm.environment.set('clubId', pm.response.json().clubId);"] } }]
        },
        {
          "name": "Crear equipo",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"name\": \"Equipo Postman {{runSuffix}}\", \"gender\": \"Female\", \"clubId\": {{clubId}} }" }, "url": "{{baseUrl}}/api/admin/teams" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('201 Created', () => pm.response.to.have.status(201));", "if (pm.response.code === 201) pm.environment.set('teamId', pm.response.json().teamId);"] } }]
        },
        {
          "name": "Inscribir equipo",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"teamId\": {{teamId}}, \"seed\": 1 }" }, "url": "{{baseUrl}}/api/admin/competitions/{{competitionId}}/entries" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('201 Created', () => pm.response.to.have.status(201));", "if (pm.response.code === 201) pm.environment.set('entryId', pm.response.json().teamEntryId);"] } }]
        },
        {
          "name": "Listar inscripciones",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/competitions/{{competitionId}}/entries" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Incluye la inscripción', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().some(x => x.teamEntryId == pm.environment.get('entryId'))).to.be.true; });"] } }]
        },
        {
          "name": "Cambiar estado de inscripción",
          "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"status\": \"Active\" }" }, "url": "{{baseUrl}}/api/admin/competitions/{{competitionId}}/entries/{{entryId}}/status" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"] } }]
        }
      ]
    },
    {
      "name": "03 - Consultas rápidas",
      "item": [
        { "name": "Temporadas activas", "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/seasons?active=true" } },
        { "name": "Divisionales femeninas", "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/divisions?gender=Female&active=true" } },
        { "name": "Clubes activos", "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/clubs?active=true" } },
        { "name": "Equipos del club", "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/teams?clubId={{clubId}}&gender=Female&active=true" } },
        { "name": "Formatos para 2 equipos", "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/competition-formats?active=true&teamCount=2" } },
        { "name": "Obtener competición", "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/competitions/{{competitionId}}" } }
      ]
    },
    {
      "name": "04 - Standings",
      "description": "La consulta de grupo requiere phaseId y phaseGroupId de una competición con participantes ya materializados en PHASE_GROUP_ENTRY.",
      "item": [
        {
          "name": "Consultar standings de fase regular",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/competitions/{{competitionId}}/phases/{{phaseId}}/standings" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200 y posiciones', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().positions).to.be.an('array'); });"] } }]
        },
        {
          "name": "Consultar standings de grupo",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/competitions/{{competitionId}}/phases/{{phaseId}}/standings?phaseGroupId={{phaseGroupId}}" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200 y scope de grupo', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().phaseGroupId.toString()).to.eql(pm.environment.get('phaseGroupId')); });"] } }]
        },
        {
          "name": "Error por grupo inválido",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/competitions/{{competitionId}}/phases/{{phaseId}}/standings?phaseGroupId=2147483647" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('400 o 404 ProblemDetails', () => { pm.expect(pm.response.code).to.be.oneOf([400,404]); pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json'); });"] } }]
        }
      ]
    },
    {
      "name": "05 - Phase Completion",
      "description": "Use completionCompetitionId/completionPhaseId para una fase IN_PROGRESS con todos sus partidos FINISHED. Use blockedCompetitionId/blockedPhaseId para una fase con partidos pendientes o cancelados.",
      "item": [
        {
          "name": "Preview exitoso",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/competitions/{{completionCompetitionId}}/phases/{{completionPhaseId}}/completion-preview" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200 y CanComplete true', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().canComplete).to.be.true; });"] } }]
        },
        {
          "name": "Preview con blockers",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/competitions/{{blockedCompetitionId}}/phases/{{blockedPhaseId}}/completion-preview" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200, CanComplete false y blockers', () => { pm.response.to.have.status(200); const body = pm.response.json(); pm.expect(body.canComplete).to.be.false; pm.expect(body.blockers).to.be.an('array').that.is.not.empty; });"] } }]
        },
        {
          "name": "CompletePhase exitoso",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/admin/competitions/{{completionCompetitionId}}/phases/{{completionPhaseId}}/complete" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200, Finished y primera ejecución', () => { pm.response.to.have.status(200); const body = pm.response.json(); pm.expect(body.status).to.eql('Finished'); pm.expect(body.alreadyCompleted).to.be.false; });"] } }]
        },
        {
          "name": "CompletePhase repetido e idempotente",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/admin/competitions/{{completionCompetitionId}}/phases/{{completionPhaseId}}/complete" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200, Finished y AlreadyCompleted', () => { pm.response.to.have.status(200); const body = pm.response.json(); pm.expect(body.status).to.eql('Finished'); pm.expect(body.alreadyCompleted).to.be.true; });"] } }]
        },
        {
          "name": "CompletePhase bloqueado",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/admin/competitions/{{blockedCompetitionId}}/phases/{{blockedPhaseId}}/complete" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('409 phase_cannot_complete', () => { pm.response.to.have.status(409); pm.expect(pm.response.json().code).to.eql('phase_cannot_complete'); });"] } }]
        }
      ]
    },
    {
      "name": "06 - Competition Progression y Completion",
      "description": "Use completionCompetitionId para una Competition IN_PROGRESS totalmente resuelta y blockedCompetitionId para una Competition con blockers.",
      "item": [
        {
          "name": "Consultar progresión deportiva",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/competitions/{{completionCompetitionId}}/progression" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200 y contadores consistentes', () => { pm.response.to.have.status(200); const body=pm.response.json(); pm.expect(body.matches.total).to.eql(body.matches.pending + body.matches.inProgress + body.matches.finished + body.matches.cancelled); });"] } }]
        },
        {
          "name": "Preview de cierre exitoso",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/competitions/{{completionCompetitionId}}/completion-preview" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200 y CanComplete true', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().canComplete).to.be.true; });"] } }]
        },
        {
          "name": "Preview de cierre con blockers",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/competitions/{{blockedCompetitionId}}/completion-preview" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200 y blockers', () => { pm.response.to.have.status(200); const body=pm.response.json(); pm.expect(body.canComplete).to.be.false; pm.expect(body.blockers).to.be.an('array').that.is.not.empty; });"] } }]
        },
        {
          "name": "CompleteCompetition exitoso",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/admin/competitions/{{completionCompetitionId}}/complete" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Finished con CompletedAt', () => { pm.response.to.have.status(200); const body=pm.response.json(); pm.expect(body.status).to.eql('Finished'); pm.expect(body.alreadyCompleted).to.be.false; pm.expect(body.completedAt).to.not.be.null; });"] } }]
        },
        {
          "name": "CompleteCompetition repetido",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/admin/competitions/{{completionCompetitionId}}/complete" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Cierre idempotente', () => { pm.response.to.have.status(200); const body=pm.response.json(); pm.expect(body.status).to.eql('Finished'); pm.expect(body.alreadyCompleted).to.be.true; });"] } }]
        },
        {
          "name": "CompleteCompetition bloqueado",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/admin/competitions/{{blockedCompetitionId}}/complete" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('409 con blockers estructurados', () => { pm.response.to.have.status(409); const body=pm.response.json(); pm.expect(body.code).to.eql('competition_cannot_complete'); pm.expect(body.blockers).to.be.an('array').that.is.not.empty; });"] } }]
        }
      ]
    },
    {
      "name": "07 - People",
      "description": "Person, additional documents and Player/Coach/Referee profiles.",
      "item": [
        { "name": "Create Person", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"documentType\": \"CI\", \"documentNumber\": \"PM-{{runSuffix}}\", \"firstName\": \"Ana\", \"lastName\": \"Postman\", \"birthDate\": \"2000-05-10\", \"gender\": \"Female\", \"email\": \"ana@example.com\", \"phone\": \"099123456\" }" }, "url": "{{baseUrl}}/api/admin/people" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('201 and ID', () => { pm.response.to.have.status(201); pm.expect(pm.response.json().personId).to.be.a('number'); });", "if (pm.response.code === 201) pm.environment.set('personId', pm.response.json().personId);"] } }] },
        { "name": "Search Person", "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/people?query=Postman&page=1&pageSize=25" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200 paged', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().items).to.be.an('array'); });"] } }] },
        { "name": "Get Person", "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/people/{{personId}}" } },
        { "name": "Update Person", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"documentType\": \"CI\", \"documentNumber\": \"PM-{{runSuffix}}\", \"firstName\": \"Ana Maria\", \"lastName\": \"Postman\", \"birthDate\": \"2000-05-10\", \"gender\": \"Female\", \"email\": \"ana@example.com\", \"phone\": \"099123456\" }" }, "url": "{{baseUrl}}/api/admin/people/{{personId}}" } },
        { "name": "Deactivate / Reactivate Person", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"active\": true }" }, "url": "{{baseUrl}}/api/admin/people/{{personId}}/active" } },
        { "name": "Add Health Card", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"documentType\": \"HealthCard\", \"documentNumber\": \"HC-{{runSuffix}}\", \"validFrom\": \"2026-01-01\", \"validTo\": \"2099-12-31\", \"notes\": \"Postman\" }" }, "url": "{{baseUrl}}/api/admin/people/{{personId}}/additional-documents" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('201 document', () => pm.response.to.have.status(201));", "if (pm.response.code === 201) pm.environment.set('documentId', pm.response.json().personAdditionalDocumentId);"] } }] },
        { "name": "Add League Card", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"documentType\": \"LeagueCard\", \"documentNumber\": \"LC-{{runSuffix}}\", \"validFrom\": null, \"validTo\": null, \"notes\": null }" }, "url": "{{baseUrl}}/api/admin/people/{{personId}}/additional-documents" } },
        { "name": "Update Document", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"documentType\": \"HealthCard\", \"documentNumber\": \"HC-{{runSuffix}}\", \"validFrom\": \"2026-01-01\", \"validTo\": \"2099-12-31\", \"notes\": \"Updated\" }" }, "url": "{{baseUrl}}/api/admin/people/{{personId}}/additional-documents/{{documentId}}" } },
        { "name": "Deactivate Document", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"active\": false }" }, "url": "{{baseUrl}}/api/admin/people/{{personId}}/additional-documents/{{documentId}}/active" } },
        { "name": "Create Player", "request": { "method": "POST", "url": "{{baseUrl}}/api/admin/people/{{personId}}/player" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('201 with HealthCard status', () => { pm.response.to.have.status(201); pm.expect(pm.response.json().healthCard.status).to.exist; });", "if (pm.response.code === 201) pm.environment.set('playerId', pm.response.json().playerId);"] } }] },
        { "name": "Create Coach", "request": { "method": "POST", "url": "{{baseUrl}}/api/admin/people/{{personId}}/coach" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 201) pm.environment.set('coachId', pm.response.json().coachId);"] } }] },
        { "name": "Create Referee", "request": { "method": "POST", "url": "{{baseUrl}}/api/admin/people/{{personId}}/referee" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 201) pm.environment.set('refereeId', pm.response.json().refereeId);"] } }] },
        { "name": "Deactivate / Reactivate Player", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"active\": true }" }, "url": "{{baseUrl}}/api/admin/players/{{playerId}}/active" } },
        { "name": "Deactivate / Reactivate Coach", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"active\": true }" }, "url": "{{baseUrl}}/api/admin/coaches/{{coachId}}/active" } },
        { "name": "Deactivate / Reactivate Referee", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"active\": true }" }, "url": "{{baseUrl}}/api/admin/referees/{{refereeId}}/active" } }
      ]
    },
    {
      "name": "08 - Casos de error",
      "item": [
        {
          "name": "Temporada duplicada devuelve 409",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"year\": 2090, \"name\": \"Duplicada\", \"startDate\": null, \"endDate\": null }" }, "url": "{{baseUrl}}/api/admin/seasons" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('409 ProblemDetails', () => { pm.response.to.have.status(409); pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json'); });"] } }]
        },
        {
          "name": "Recurso inexistente devuelve 404",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/divisions/2147483647" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('404 ProblemDetails', () => { pm.response.to.have.status(404); pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json'); });"] } }]
        }
      ]
    }
  ]
}
